"""
CrewAI HTTP API server — bridges OpenClaw (Docker) to the host CrewAI crews.

Run on the host with:
    cd .crewai && uv run python -m {{PY_PACKAGE}}.server

OpenClaw's Claude Code agent (inside Docker) then calls:
    POST http://host.docker.internal:9317/run
    GET  http://host.docker.internal:9317/health

Port default: 9317 (set CREWAI_SERVER_PORT or pass --port to override).
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

from dotenv import load_dotenv


def _setup_env() -> None:
    """Load .env from the .crewai directory before handling any requests."""
    load_dotenv()
    mode = os.getenv("CREWAI_LLM_MODE", "direct").strip().lower()
    if mode == "proxy":
        proxy_key = os.getenv("CLI_PROXY_API_KEY", "").strip()
        proxy_base = os.getenv("CLI_PROXY_BASE_URL", "").strip()
        if proxy_key and not os.getenv("OPENAI_API_KEY"):
            os.environ["OPENAI_API_KEY"] = proxy_key
        if proxy_base and not os.getenv("OPENAI_BASE_URL"):
            os.environ["OPENAI_BASE_URL"] = proxy_base
        if proxy_base and not os.getenv("OPENAI_API_BASE"):
            os.environ["OPENAI_API_BASE"] = proxy_base


class CrewAIHandler(BaseHTTPRequestHandler):
    def log_message(self, fmt: str, *args: object) -> None:
        print(f"[crewai-server] {self.address_string()} - {fmt % args}", flush=True)

    def _send_json(self, data: dict, code: int = 200) -> None:
        body = json.dumps(data).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _read_body(self) -> dict | None:
        length = int(self.headers.get("Content-Length", 0))
        if length == 0:
            return {}
        try:
            return json.loads(self.rfile.read(length))
        except (json.JSONDecodeError, ValueError):
            return None

    def do_GET(self) -> None:
        if self.path == "/health":
            from . import __version__ as ver  # noqa: F401
            self._send_json({"status": "ok", "server": "crewai-api"})
        elif self.path.startswith("/result/"):
            slug = self.path.removeprefix("/result/").strip("/")
            workspace = os.getenv("CREWAI_WORKSPACE", "").strip() or os.getcwd()
            result_file = Path(workspace) / "bin" / "outputs" / slug / "result.md"
            if result_file.exists():
                self._send_json({"status": "done", "result": result_file.read_text("utf-8")})
            else:
                self._send_json({"status": "pending", "slug": slug}, code=202)
        else:
            self._send_json({"error": "not found"}, code=404)

    def do_POST(self) -> None:
        if self.path == "/run":
            body = self._read_body()
            if body is None:
                self._send_json({"error": "invalid JSON body"}, code=400)
                return

            task = (body.get("task") or "").strip()
            task_type = (body.get("type") or "auto").strip().lower()
            workspace = (body.get("workspace") or os.getenv("CREWAI_WORKSPACE", "")).strip()

            if not task:
                self._send_json({"error": "'task' field is required"}, code=400)
                return

            print(f"[crewai-server] dispatching: type={task_type!r} task={task[:80]!r}", flush=True)

            try:
                from .router import dispatch
                result = dispatch(task, task_type, workspace=workspace)
                # Write result to disk so callers can also poll it later
                if workspace:
                    import re
                    slug = re.sub(r"[^a-z0-9]+", "-", task[:60].lower()).strip("-") or "task"
                    out = Path(workspace) / "bin" / "outputs" / slug
                    out.mkdir(parents=True, exist_ok=True)
                    (out / "result.md").write_text(result, encoding="utf-8")
                self._send_json({"result": result, "type": task_type})
            except Exception as exc:  # noqa: BLE001
                print(f"[crewai-server] dispatch error: {exc}", file=sys.stderr, flush=True)
                self._send_json({"error": str(exc)}, code=500)

        elif self.path == "/crews":
            try:
                from .crews import list_crews
                self._send_json({"crews": list_crews()})
            except Exception as exc:  # noqa: BLE001
                self._send_json({"error": str(exc)}, code=500)
        else:
            self._send_json({"error": "not found"}, code=404)


def main() -> None:
    parser = argparse.ArgumentParser(description="CrewAI HTTP API server")
    parser.add_argument("--port", type=int, default=int(os.getenv("CREWAI_SERVER_PORT", "9317")))
    parser.add_argument("--host", default=os.getenv("CREWAI_SERVER_HOST", "0.0.0.0"))
    parser.add_argument("--workspace", default=os.getenv("CREWAI_WORKSPACE", ""))
    args = parser.parse_args()

    _setup_env()

    if args.workspace:
        os.environ["CREWAI_WORKSPACE"] = args.workspace

    server = ThreadingHTTPServer((args.host, args.port), CrewAIHandler)
    print(f"[crewai-server] listening on {args.host}:{args.port}", flush=True)
    if args.workspace:
        print(f"[crewai-server] workspace: {args.workspace}", flush=True)
    print("[crewai-server] endpoints:", flush=True)
    print(f"  GET  http://localhost:{args.port}/health", flush=True)
    print(f"  GET  http://localhost:{args.port}/crews", flush=True)
    print(f"  POST http://localhost:{args.port}/run  {{\"type\": \"research\", \"task\": \"...\"}}", flush=True)
    print("[crewai-server] from OpenClaw Docker container:", flush=True)
    print(f"  POST http://host.docker.internal:{args.port}/run", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n[crewai-server] shutting down", flush=True)
        server.shutdown()


if __name__ == "__main__":
    main()
